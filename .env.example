# Local development needs no secrets in this file. The launcher uses local mode.
# Production: configure these in the hosting provider's secret manager.
# This file is documentation; application settings read environment variables.
KONTTURI_ENV=production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=cms.example.fi,www.example.fi,example.fi
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CMS_BASE_URL=https://cms.example.fi
CSRF_TRUSTED_ORIGINS=https://cms.example.fi,https://example.fi,https://www.example.fi
# Enable only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_HTTPS_PROXY=1
# Use a persistent disk; back it up together with PostgreSQL.
MEDIA_ROOT=/var/lib/kontturi/media
# Free hosted staging uses external object storage instead of a Render disk.
# Set KONTTURI_ENV=staging, MEDIA_STORAGE=s3 and the private values below.
# Keep these credentials in the provider's secret manager, never in Git.
MEDIA_STORAGE=filesystem
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=eu-central-1
# Keep staging out of search. Turn on only for the approved production domain.
INDEX_SITE=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
